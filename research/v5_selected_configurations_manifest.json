      "precedence": "amendment_overrides_frozen_block"
    },
    "overlap": {
      "path": "configs/research_v5_candidate_freeze_amendment_1.json",
      "manifest_hash": "43a374284df1c5f933f565c0e882d6c721302e5b1897c02ceb39344b1effa49d",
      "rule": "the v5 confirmatory window opens inside the still-open v2, v3 and v4 confirmatory windows in time, because a 90-day window that opens later cannot end later than the 90-day window that opened before it; the time overlap is not a violation, because the two evaluations share no asset (the v5 candidate set is disjoint from the v1, v2, v3 and v4 candidate sets) and because the v5 confirmatory evaluation may not start before the later of the v4 confirmatory gate and the v5 window's own earliest end, and never before the v2 and the v3 gates; the v5 window is never populated with data that predates the v5 candidate freeze, is never a re-opening of the v1 holdout or of the v2, v3 or v4 confirmatory windows, and is never read for selection",
      "evaluation_may_not_start_before_utc": "2027-01-19T13:00:00Z",
      "precedence": "amendment_overrides_frozen_block"
    },
    "execution": {
      "path": "configs/research_v5_execution_amendment_1.json",
      "manifest_hash": "a5c5384c72a55c42417ffa58f5faebb5e3cc0fab0ed828d5ca7c9b59f9d25988",
      "precedence": "the effective v5 execution protocol is this amendment for the blocks it restates, and configs/research_v5_execution.json for the blocks it does not; the protocol stays on disk unchanged and visible"
